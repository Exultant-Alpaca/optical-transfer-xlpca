{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/send", "destination": "/index.html" },
    { "source": "/send/:path*", "destination": "/index.html" },
    { "source": "/receive", "destination": "/index.html" },
    { "source": "/receive/:path*", "destination": "/index.html" },
    { "source": "/qrstatic", "destination": "/index.html" },
    { "source": "/qrstatic/:path*", "destination": "/index.html" },
    { "source": "/guide", "destination": "/index.html" },
    { "source": "/guide/:path*", "destination": "/index.html" },
    { "source": "/limitations", "destination": "/index.html" },
    { "source": "/limitations/:path*", "destination": "/index.html" },
    { "source": "/source", "destination": "/index.html" },
    { "source": "/source/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), payment=()" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
